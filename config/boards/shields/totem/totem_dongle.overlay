/ {
    chosen {
        zmk,display = &st7789;
    };
};

/* =========================
 * PINCTRL
 * ========================= */
&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 0, 5)>,
                    <NRF_PSEL(TWIM_SDA, 0, 4)>;
            bias-pull-up;
        };
    };
};

/* =========================
 * I2C (Sensor board)
 * ========================= */
&i2c0 {
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-names = "default";
};

/* =========================
 * SPI (ST7789 Display)
 * ========================= */
&spi1 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    sck-pin = <8>;
    mosi-pin = <10>;
    miso-pin = <255>;

    st7789: st7789@0 {
        compatible = "sitronix,st7789v";
        reg = <0>;
        spi-max-frequency = <8000000>;

        cs-gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
        dc-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;

        width = <240>;
        height = <240>;
        rotation = <0>;
        status = "okay";
    };
};
