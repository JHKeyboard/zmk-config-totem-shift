#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    chosen {
        zmk,display = &st7789;
    };
};

/* =========================
 * PINCTRL DEFINITIONS
 * ========================= */
&pinctrl {

    /* I2C0 (Sensor) */
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 0, 5)>,
                    <NRF_PSEL(TWIM_SDA, 0, 4)>;
            bias-pull-up;
        };
    };

    /* SPI1 (ST7789) */
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 10)>;
        };
    };
};

/* =========================
 * I2C0
 * ========================= */
