&spi1 {
    status = "okay";

    st7789: st7789@0 {
        compatible = "sitronix,st7789v";
        reg = <0>;
        spi-max-frequency = <8000000>;
        dc-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
        width = <240>;
        height = <240>;
    };
};

 / {
    chosen {
        zephyr,display = &st7789;
    };
};
