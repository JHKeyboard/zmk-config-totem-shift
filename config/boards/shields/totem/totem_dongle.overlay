#include <dt-bindings/zmk/matrix_transform.h>

#include "totem-layouts.dtsi"

/ {
    chosen {
        zephyr,display = &st7789;
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &physical_layout0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
                RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
                RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
        RC(3,0) RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(3,9)
                                RC(3,2) RC(3,3) RC(3,4)    RC(3,5) RC(3,6) RC(3,7)         
        >;
    };

    mock_kscan: kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};

&xiao_spi {
    status = "okay";
    cs-gpios = <&xiao_d 9 GPIO_ACTIVE_LOW>; // 배선도 LCD_CS -> XIAO D9

    st7789: st7789@0 {
        compatible = "sitronix,st7789v";
        reg = <0>;
        spi-max-frequency = <20000000>;
        
        /* 디스플레이 사양 (일반적인 0.96인치/1.1인치 ST7789 설정) */
        width = <172>;
        height = <320>;
        x-offset = <0>;
        y-offset = <0>;
        
        dc-gpios = <&xiao_d 3 GPIO_ACTIVE_LOW>;     // 배선도 LCD_DC -> XIAO D3
        reset-gpios = <&xiao_d 2 GPIO_ACTIVE_LOW>;  // 배선도 LCD_RST -> XIAO D2
        backlight-gpios = <&xiao_d 6 GPIO_ACTIVE_HIGH>; // 배선도 LCD_BL -> XIAO D6
    };
};

&physical_layout0 {
    transform
