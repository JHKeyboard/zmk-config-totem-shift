/*
 * Dongle screen overlay
 * Board: Seeed XIAO BLE (nRF52840)
 * Display: ST7789
 * Zephyr >= 3.5 compatible
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    chosen {
        zephyr,display = &st7789;
    };
};

/* =========================
 * SPI1 PINCTRL DEFINITIONS
 * ========================= */

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <
                NRF_PSEL(SPIM_SCK,  0, 13)
                NRF_PSEL(SPIM_MOSI, 0, 15)
                NRF_PSEL(SPIM_MISO, 0, 14)
            >;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <
                NRF_PSEL(SPIM_SCK,  0, 13)
                NRF_PSEL(SPIM_MOSI, 0, 15)
                NRF_PSEL(SPIM_MISO, 0, 14)
            >;
            low-power-enable;
        };
    };
};

/* =========================
 * SPI1 BUS + ST7789 DISPLAY
 * ========================= */

&spi1 {
    status = "okay";

    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";

    st7789: st7789@0 {
        compatible = "sitronix,st7789v";
        reg = <0>;

        spi-max-frequency = <8000000>;
        label = "ST7789";

        width = <240>;
        height = <240>;
        x-offset = <0>;
        y-offset = <0>;

        /* Required by binding */
        porch-param = <0 0 0 0 0 0>;

        madctl = <0x00>;
        colmod = <0x55>;

        cs-gpios    = <&gpio0 1 GPIO_ACTIVE_LOW>;
        dc-gpios    = <&gpio0 3 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
    };
};
