/*
 * Dongle screen overlay for XIAO BLE + ST7789
 * Fixes:
 *  - required porch-param
 *  - missing st7789 label for /chosen
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zephyr,display = &st7789;
    };
};

&spi1 {
    status = "okay";

    st7789: st7789@0 {
        compatible = "sitronix,st7789v";
        reg = <0>;

        spi-max-frequency = <8000000>;

        label = "ST7789";

        width = <240>;
        height = <240>;
        x-offset = <0>;
        y-offset = <0>;

        /* Required by sitronix,st7789v binding */
        porch-param = <0 0 0 0 0 0>;

        /* Typical ST7789 config */
        madctl = <0x00>;
        colmod = <0x55>;

        reset-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
        dc-gpios    = <&gpio0 3 GPIO_ACTIVE_HIGH>;
    };
};
